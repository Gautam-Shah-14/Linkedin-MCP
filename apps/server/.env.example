# Copy this file to apps/server/.env and fill in the values below.
# See the "LinkedIn MCP — Local Setup & Test Guide" doc for the full walkthrough.

NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000

# Supabase: Project Settings -> Database -> Connection string -> Session pooler.
# Use the session pooler (not the direct connection) — the direct host can be
# IPv6-only, which breaks from environments that can't reach IPv6.
DATABASE_URL=

# Any random string — signs the server's own JWT access tokens.
JWT_SIGNING_KEY=

# Base64 of exactly 32 raw bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# LinkedIn API version header, e.g. 202401. Any value works while LINKEDIN_MOCK=true.
LINKEDIN_VERSION=202401

# true = use the built-in mock LinkedIn client (no real LinkedIn app needed).
# Keep this true until real LinkedIn App A credentials exist (see PLAN.md §7).
LINKEDIN_MOCK=true

# Only needed once LINKEDIN_MOCK=false.
LINKEDIN_SHARE_CLIENT_ID=
LINKEDIN_SHARE_CLIENT_SECRET=
LINKEDIN_COMMUNITY_CLIENT_ID=
LINKEDIN_COMMUNITY_CLIENT_SECRET=

ALLOWED_OAUTH_REDIRECTS=https://claude.ai/api/mcp/auth_callback

# Only needed once Phase 6 (scheduled-post failure alerts) is built.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
